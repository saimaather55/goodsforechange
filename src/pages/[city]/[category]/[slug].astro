<!doctype html>
<html lang="en">

<head>

<meta charset="UTF-8" />

<meta name="viewport" content="width=device-width" />

<title>{title}</title>

<meta
name="description"
content={description}
/>


<link
rel="canonical"
href={`https://goodsforechange.pages.dev/${listing.city.toLowerCase()}/${listing.categories.slug}/${listing.slug}/`}
/>


</head>


<body>


<Navbar />


<main>


<section class="page-header">

<div class="container">

