---
import Navbar from "../../../components/Navbar.astro";
import { createClient } from "@supabase/supabase-js";


export async function getStaticPaths() {

  return [
    {
      params: {
        city: "karachi",
        category: "electronics",
        slug: "iphone-swap"
      }
    },
    {
      params: {
        city: "karachi",
        category: "vehicles",
        slug: "bike-swap"
      }
    },
    {
      params: {
        city: "karachi",
        category: "books",
        slug: "book-exchange"
      }
    }
  ];

}



const { slug } = Astro.params;



const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);



const { data: listing, error } = await supabase
  .from("listings")
  .select("*")
  .eq("slug", slug)
  .single();



if (error || !listing) {

  throw new Error("Listing not found");

}



const title =
`${listing.title} for Exchange in ${listing.city} | GoodsForExchange`;



const description =
`${listing.title} available for exchange in ${listing.city}. Looking for ${listing.desired_exchange || "offers"}.`;



const { data: images } = await supabase
  .from("listing_images")
  .select("image_url")
  .eq("listing_id", listing.id)
  .order("sort_order");



const postedDate = listing.created_at
  ? new Date(listing.created_at).toLocaleDateString()
  : "Not available";

---
<!doctype html>
<html lang="en">

<head>

<meta charset="UTF-8" />

<meta name="viewport" content="width=device-width" />

<title>{title}</title>

<meta 
name="description"
content={description}
/>

<link 
rel="canonical"
href={`https://goodsforechange.pages.dev/${listing.city?.toLowerCase()}/${listing.category_id}/${listing.slug}/`}
/>


<style is:global>

*{
box-sizing:border-box;
}


body{

margin:0;
font-family:
Inter,
system-ui,
sans-serif;

background:#f7fafb;
color:#172033;
line-height:1.6;

}


a{

text-decoration:none;
color:inherit;

}


.container{

width:min(1120px,calc(100% - 40px));
margin:auto;

}


.page-header{

padding:60px 0 40px;
background:white;

}


.eyebrow{

color:#176b87;
font-size:13px;
font-weight:800;
text-transform:uppercase;

}


h1{

margin:10px 0;
font-size:44px;

}



.listing-section{

padding:50px 0;

}



.listing-card{

background:white;
border:1px solid #e0e7eb;
border-radius:16px;
overflow:hidden;
box-shadow:0 8px 30px rgba(20,40,50,.05);

}



.gallery{

background:#eef5f7;
padding:20px;

}



.main-image{

width:100%;
height:500px;
object-fit:contain;
background:white;
border-radius:12px;

}



.content{

padding:32px;

}



.condition{

display:inline-block;
background:#eaf6f8;
color:#176b87;
padding:5px 12px;
border-radius:20px;
font-weight:800;
font-size:13px;

}



.content h2{

font-size:32px;

}



.description{

color:#586579;
font-size:17px;

}



.details{

margin-top:30px;
padding:20px;
background:#f7fafb;
border-radius:12px;

}



.details div{

margin-bottom:15px;

}



.seller,
.notice{

margin-top:25px;
padding:20px;
border-radius:10px;

}


.seller{

background:#eef7fa;

}


.notice{

background:#fff8e8;

}



.button{

display:inline-block;
margin-top:20px;
padding:13px 22px;
background:#176b87;
color:white;
border-radius:8px;
font-weight:800;

}



footer{

margin-top:50px;
padding:35px 0;
background:#102d38;
color:white;

}


</style>


</head>


<body>


<Navbar />


<main>


<section class="page-header">

<div class="container">

<span class="eyebrow">
Exchange Listing
</span>


<h1>
{listing.title}
</h1>


</div>

</section>


<section class="listing-section">

<div class="container">


<article class="listing-card">


{images && images.length > 0 && (

<div class="gallery">

<img

class="main-image"

src={images[0].image_url}

alt={listing.title}

/>

</div>

)}



<div class="content">


<span class="condition">

{listing.condition} Condition

</span>



<h2>
{listing.title}
</h2>



<p class="description">

{listing.description}

</p>


<div class="details">


<div>

<strong>
Location
</strong>

<p>
📍 {listing.city}, {listing.country}
</p>


{listing.landmark && (

<p>
Near {listing.landmark}
</p>

)}


{listing.distance && (

<p>
Approx {listing.distance}
</p>

)}


</div>



<div>

<strong>
Looking For
</strong>

<p>
🔄 {listing.desired_exchange}
</p>


</div>



<div>

<strong>
Posted
</strong>

<p>
{postedDate}
</p>


</div>


</div>
<div class="seller">

<strong>
Seller Information
</strong>

<p>
GoodsForExchange User
</p>

</div>



<div class="notice">

<strong>
Safety Notice
</strong>

<p>
Please inspect items and verify details before completing an exchange.
</p>

</div>



<a
class="button"
href={`/chat/?listing=${listing.id}&owner=${listing.user_id}`}
>
💬 Message Owner
</a>



</div>


</article>


</div>

</section>


</main>



<footer>

<div class="container">

<strong>
GoodsForExchange
</strong>


<p>
Exchange what you have for what you want.
</p>


</div>

</footer>



</body>

</html>