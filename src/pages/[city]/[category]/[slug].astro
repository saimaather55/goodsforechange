---
import Navbar from "../../../components/Navbar.astro";
import { createClient } from "@supabase/supabase-js";





export async function getStaticPaths() {

const supabaseClient = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);
  const { data: listings, error } = await supabaseClient
    .from("listings")
    .select(`
      slug,
      city,
      categories (
        slug
      )
    `);


  if (error) {
    throw new Error(error.message);
  }


  return (listings || []).map((item)=>({

    params:{
      city: item.city.toLowerCase(),
      category: item.categories.slug,
      slug: item.slug
    }

  }));

}


const { city, category, slug } = Astro.params;



const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);



const { data: listing, error } = await supabase

  .from("listings")

  .select(`
    *,
    categories (
      slug
    )
  `)

  .eq("slug", slug)

  .ilike("city", city)

  .single();



if (error || !listing) {

  throw new Error("Listing not found");

}



const title =
`${listing.title} for Exchange in ${listing.city} | GoodsForExchange`;



const description =
`${listing.title} available for exchange in ${listing.city}. Looking for ${listing.desired_exchange || "offers"}.`;



const { data: images } = await supabase

  .from("listing_images")

  .select("image_url")

  .eq("listing_id", listing.id)

  .order("sort_order");



const postedDate = listing.created_at

? new Date(listing.created_at).toLocaleDateString()

: "Not available";

---
<style is:global>

*{
box-sizing:border-box;
}


body{

margin:0;

font-family:
Inter,
system-ui,
sans-serif;

