📍 {listing.city}, {listing.country}
</p>


{listing.landmark && (

<p>
Near {listing.landmark}
</p>

)}


{listing.distance && (

<p>
Approx {listing.distance}
</p>

)}


</div>




<div>

<strong>
Looking For
</strong>


<p>
🔄 {listing.desired_exchange || "Open offers"}
</p>


</div>




<div>

<strong>
Posted
</strong>


<p>
{postedDate}
</p>


</div>



</div>





