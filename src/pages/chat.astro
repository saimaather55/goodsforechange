---
import Navbar from "../components/Navbar.astro";
const title = "Chat | GoodsForExchange";
const description = "Chat with users about exchange listings.";
---

<!doctype html>
<html lang="en">

<head>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>

<meta name="description" content={description} />


<style is:global>

*{
box-sizing:border-box;
}


body{
margin:0;
font-family:Inter,system-ui,sans-serif;
background:#f7fafb;
color:#172033;
}


.container{
width:min(900px,calc(100% - 40px));
margin:auto;
}


.site-header{
background:white;
border-bottom:1px solid #e4eaee;
}


.nav{
min-height:72px
display:flex;
align-items:center;
justify-content:space-between;
}


.logo{
color:#176b87;
font-size:21px;
font-weight:800;
}


nav{
display:flex;
gap:20px;
font-weight:600;
}



main{
padding:50px 0;
}


.chat-box{

background:white;
border:1px solid #dfe8eb;
border-radius:16px;
overflow:hidden;

}



.chat-header{

padding:20px;
background:#176b87;
color:white;

}



.notice{

padding:15px;
background:#fff8e8;
font-size:14px;
color:#625b4d;

}



.messages{

height:400px;
overflow-y:auto;
padding:20px;

display:flex;
flex-direction:column;
gap:12px;

}



.message{

max-width:70%;
padding:10px 14px;
border-radius:12px;

}



.mine{

align-self:flex-end;
background:#176b87;
color:white;

}



.theirs{

align-self:flex-start;
background:#eef5f7;

}



.send-box{

display:flex;
gap:10px;
padding:20px;
border-top:1px solid #e4eaee;

}



.send-box input{

flex:1;
padding:12px;
border:1px solid #ccd7de;
border-radius:8px;

}



button{

padding:12px 20px;
border:none;
border-radius:8px;
background:#176b87;
color:white;
font-weight:700;
cursor:pointer;

}


footer{

margin-top:50px;
padding:30px 0;
background:#102d38;
color:white;

}


</style>


</head>


<body>

<Navbar />




<main>


<div class="container">


<div class="chat-box">


<div class="chat-header">

<h2>
Exchange Chat
</h2>

</div>



<div class="notice">

<strong>Safety Notice:</strong>

<br>

GoodsForExchange only provides a platform to connect users.
Please verify item details, ownership and condition before completing any exchange.
GoodsForExchange is not responsible for any loss, fraud or disputes.

</div>




<div id="messages" class="messages">

<p>
Loading messages...
</p>

</div>




<div class="send-box">


<input
id="message-input"
placeholder="Write your message..."
/>


<button id="send-btn">
Send
</button>


</div>


</div>


</div>


</main>





<footer>

<div class="container">

<strong>
GoodsForExchange
</strong>

<p>
Exchange what you have for what you want.
</p>

</div>

</footer>





<script>

import { createClient } from "@supabase/supabase-js";


const supabase=createClient(

import.meta.env.PUBLIC_SUPABASE_URL,

import.meta.env.PUBLIC_SUPABASE_ANON_KEY

);



const params =
new URLSearchParams(window.location.search);


const listingId =
params.get("listing");


const ownerId =
params.get("owner");



const messagesBox =
document.querySelector("#messages");


const input =
document.querySelector("#message-input");


const button =
document.querySelector("#send-btn");



let currentUser = null;




async function init(){


const {
data:{user}
}=await supabase.auth.getUser();



if(!user){

messagesBox.innerHTML =
"<p>Please login first.</p>";

return;

}



currentUser=user;


loadMessages();


}





async function loadMessages(){


const {data,error}=await supabase

.from("messages")

.select("*")

.eq("listing_id",listingId)

.order("created_at",{ascending:true});



if(error){

console.log(error);

return;

}



if(!data || data.length===0){

messagesBox.innerHTML =
"<p>No messages yet. Start conversation.</p>";

return;

}



messagesBox.innerHTML =
data.map(msg=>{


return `

<div class="message ${
msg.sender_id===currentUser.id
?"mine"
:"theirs"
}">

${msg.content}

</div>

`;

}).join("");



messagesBox.scrollTop =
messagesBox.scrollHeight;


}





button.addEventListener(
"click",
async()=>{


const text =
input.value.trim();



if(!text) return;



await supabase

.from("messages")

.insert({

listing_id:listingId,

sender_id:currentUser.id,

receiver_id:ownerId,

content:text

});



input.value="";


loadMessages();



});




init();


</script>


</body>

</html>