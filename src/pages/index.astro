---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";

const title = "Swap & Exchange Goods and Services | GoodsForExchange";
const description = "Swap and exchange goods and services with people near you. List items, discover useful swaps, and connect locally to trade what you have for what you need.";
---

<!doctype html>
<html lang="en">

<head>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href="https://goodsforechange.pages.dev/" />



<style is:global>

* {
  box-sizing: border-box;
}


html,
body {

  margin:0;
  padding:0;

  font-family:
  Inter,
  system-ui,
  -apple-system,
  BlinkMacSystemFont,
  "Segoe UI",
  sans-serif;

  color:#172033;
  background:#ffffff;

  line-height:1.6;

}



a {

  color:inherit;
  text-decoration:none;

}



.container {

  width:min(1320px, calc(100% - 40px));
  margin:0 auto;

}



.site-header {

  border-bottom:1px solid #e8edf2;
  background:#ffffff;

  position:sticky;
  top:0;
  z-index:20;

}



.nav {

  min-height:72px;

  display:flex;
  align-items:center;
  justify-content:space-between;

  gap:30px;

}



.logo {

  font-size:21px;
  font-weight:800;
  color:#176b87;

}



nav {

  display:flex;
  align-items:center;

  gap:24px;

  font-size:15px;
  font-weight:600;

}



nav a:hover {

  color:#176b87;

}



.hero {

  background:linear-gradient(135deg,#f0fafc,#ffffff);

  padding:80px 0;

}



.hero-content {

  max-width:800px;

  margin:0 auto;

  text-align:center;

}



h1 {

  margin:0 0 20px;

  font-size:clamp(36px,5vw,60px);

  line-height:1.1;

}



.section {

  padding:60px 0;

}



.section-heading {

  margin-bottom:30px;

}



.listing-grid {

  width:100%;

  display:grid;

  grid-template-columns:repeat(4,minmax(0,1fr));

  gap:20px;

}



.listing-card {

  width:100%;

  border:1px solid #e1e8ed;

  border-radius:16px;

  background:#ffffff;

  overflow:hidden;

  display:flex;

  flex-direction:column;

  cursor:pointer;

  transition:transform .2s ease, box-shadow .2s ease;

}



.listing-card:hover {

  transform:translateY(-5px);

  box-shadow:0 12px 30px rgba(20,40,50,.1);

}



.listing-image-frame {

  width:100%;

  height:200px;

  display:flex;

  align-items:center;

  justify-content:center;

  overflow:hidden;

  background:#f1f6f8;

}



.listing-image {

  width:100%;

  height:100%;

  object-fit:cover;

}



.listing-content {

  padding:16px;

  display:flex;

  flex-direction:column;

  flex-grow:1;

}



.condition {

  display:inline-block;

  padding:3px 8px;

  border-radius:999px;

  background:#eaf6f8;

  color:#176b87;

  font-size:11px;

  font-weight:800;

  margin-bottom:6px;

}



.listing-title {

  margin:0 0 6px;

  font-size:18px;

}



.listing-description {

  margin:0 0 12px;

  color:#687588;

  font-size:13px;

}



.listing-meta {

  margin-top:auto;

  padding-top:10px;

  border-top:1px solid #edf1f3;

  font-size:12px;

  color:#687588;

}
.search-box {

margin-top:30px;
display:flex;
gap:10px;
max-width:650px;
margin-left:auto;
margin-right:auto;

}


.search-box input {

flex:1;
padding:15px 18px;
border:1px solid #ccd7de;
border-radius:10px;
font-size:16px;

}


.search-box button {

padding:15px 25px;
border:none;
border-radius:10px;
background:#176b87;
color:white;
font-weight:700;
cursor:pointer;

}


.search-box button:hover {

background:#12566d;

}
.search-box select {

  padding:15px 18px;
  border:1px solid #ccd7de;
  border-radius:10px;
  font-size:16px;
  background:#ffffff;
  color:#172033;
  min-width:190px;

}


@media(max-width:600px){

.search-box{

flex-direction:column;

}

}



footer {

  padding:30px 0;

  background:#102d38;

  color:white;

}


@media(max-width:1100px){

.listing-grid{

grid-template-columns:repeat(3,minmax(0,1fr));

}

}


@media(max-width:820px){

.listing-grid{

grid-template-columns:repeat(2,minmax(0,1fr));

}

}


@media (max-width: 560px) {
  .listing-grid {
    grid-template-columns: 1fr;
  }

  .search-box {
    flex-direction: column;
  }
}

/* GOODSFOREXCHANGE FOOTER */

.site-footer {
  background: #102d38;
  color: #ffffff;
  margin-top: 60px;
  padding-top: 45px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 40px;
  padding-bottom: 35px;
}

.footer-brand,
.footer-column {
  min-width: 0;
}

.footer-logo {
  display: inline-block;
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
  margin-bottom: 12px;
}

.footer-brand p {
  max-width: 360px;
  color: #d0dce1;
  font-size: 14px;
  line-height: 1.7;
}

.footer-column {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
}

.footer-column h3 {
  margin: 0 0 8px;
  font-size: 16px;
}

.footer-column a {
  display: block;
  color: #d0dce1;
  font-size: 14px;
  line-height: 1.7;
}

.footer-column a:hover,
.footer-logo:hover {
  color: #8ed8e8;
}

.footer-bottom {
  border-top: 1px solid #34515b;
  padding: 16px 0;
}

.footer-bottom p {
  margin: 0;
  color: #d0dce1;
  font-size: 13px;
  text-align: center;
}

@media (max-width: 700px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 30px 20px;
  }

  .footer-brand {
    grid-column: 1 / -1;
  }
  

.homepage-content {
  width: 100%;
  max-width: 900px;
  margin-left: auto;
  margin-right: auto;
  padding-left: 20px;
  padding-right: 20px;
  box-sizing: border-box;
  line-height: 1.8;
}

.homepage-content h2 {
  margin-top: 36px;
  margin-bottom: 14px;
  color: #172033;
  font-size: 25px;
  line-height: 1.35;
}

.homepage-content h3 {
  margin-top: 24px;
  margin-bottom: 10px;
  color: #172033;
  font-size: 19px;
}

.homepage-content p,
.homepage-content li {
  color: #465465;
  font-size: 16px;
  line-height: 1.8;
}

.homepage-content li {
  margin-bottom: 8px;
}

@media (max-width: 600px) {
  .homepage-content {
    padding-left: 16px;
    padding-right: 16px;
  }

  .homepage-content h2 {
    font-size: 22px;
  }

  .homepage-content p,
  .homepage-content li {
    font-size: 15px;
  }
}


}



</style>

</head>


