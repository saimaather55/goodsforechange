---
import Navbar from "../components/Navbar.astro";

const title = "GoodsForExchange | Swap Goods Easily";
const description = "Exchange your items directly with people in your city.";
---

<!doctype html>
<html lang="en">

<head>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>
<meta name="description" content={description} />



<style is:global>

* {
  box-sizing: border-box;
}


html,
body {

  margin:0;
  padding:0;

  font-family:
  Inter,
  system-ui,
  -apple-system,
  BlinkMacSystemFont,
  "Segoe UI",
  sans-serif;

  color:#172033;
  background:#ffffff;

  line-height:1.6;

}



a {

  color:inherit;
  text-decoration:none;

}



.container {

  width:min(1320px, calc(100% - 40px));
  margin:0 auto;

}



.site-header {

  border-bottom:1px solid #e8edf2;
  background:#ffffff;

  position:sticky;
  top:0;
  z-index:20;

}



.nav {

  min-height:72px;

  display:flex;
  align-items:center;
  justify-content:space-between;

  gap:30px;

}



.logo {

  font-size:21px;
  font-weight:800;
  color:#176b87;

}



nav {

  display:flex;
  align-items:center;

  gap:24px;

  font-size:15px;
  font-weight:600;

}



nav a:hover {

  color:#176b87;

}



.hero {

  background:linear-gradient(135deg,#f0fafc,#ffffff);

  padding:80px 0;

}



.hero-content {

  max-width:800px;

  margin:0 auto;

  text-align:center;

}



h1 {

  margin:0 0 20px;

  font-size:clamp(36px,5vw,60px);

  line-height:1.1;

}



.section {

  padding:60px 0;

}



.section-heading {

  margin-bottom:30px;

}



.listing-grid {

  width:100%;

  display:grid;

  grid-template-columns:repeat(4,minmax(0,1fr));

  gap:20px;

}



.listing-card {

  width:100%;

  border:1px solid #e1e8ed;

  border-radius:16px;

  background:#ffffff;

  overflow:hidden;

  display:flex;

  flex-direction:column;

  cursor:pointer;

  transition:transform .2s ease, box-shadow .2s ease;

}



.listing-card:hover {

  transform:translateY(-5px);

  box-shadow:0 12px 30px rgba(20,40,50,.1);

}



.listing-image-frame {

  width:100%;

  height:200px;

  display:flex;

  align-items:center;

  justify-content:center;

  overflow:hidden;

  background:#f1f6f8;

}



.listing-image {

  width:100%;

  height:100%;

  object-fit:cover;

}



.listing-content {

  padding:16px;

  display:flex;

  flex-direction:column;

  flex-grow:1;

}



.condition {

  display:inline-block;

  padding:3px 8px;

  border-radius:999px;

  background:#eaf6f8;

  color:#176b87;

  font-size:11px;

  font-weight:800;

  margin-bottom:6px;

}



.listing-title {

  margin:0 0 6px;

  font-size:18px;

}



.listing-description {

  margin:0 0 12px;

  color:#687588;

  font-size:13px;

}



.listing-meta {

  margin-top:auto;

  padding-top:10px;

  border-top:1px solid #edf1f3;

  font-size:12px;

  color:#687588;

}
.search-box {

margin-top:30px;
display:flex;
gap:10px;
max-width:650px;
margin-left:auto;
margin-right:auto;

}


.search-box input {

flex:1;
padding:15px 18px;
border:1px solid #ccd7de;
border-radius:10px;
font-size:16px;

}


.search-box button {

padding:15px 25px;
border:none;
border-radius:10px;
background:#176b87;
color:white;
font-weight:700;
cursor:pointer;

}


.search-box button:hover {

background:#12566d;

}


@media(max-width:600px){

.search-box{

flex-direction:column;

}

}



footer {

  padding:30px 0;

  background:#102d38;

  color:white;

}


@media(max-width:1100px){

.listing-grid{

grid-template-columns:repeat(3,minmax(0,1fr));

}

}


@media(max-width:820px){

.listing-grid{

grid-template-columns:repeat(2,minmax(0,1fr));

}

}


@media(max-width:560px){

.listing-grid{

grid-template-columns:1fr;

}

}


</style>

</head>


<body>


<Navbar />


<main>


<section class="hero">

<div class="container hero-content">


<h1>
Exchange What You Have For What You Want
</h1>


<p>
<form action="/search/" method="GET" class="search-box">

<input
type="text"
name="q"
placeholder="Search items like phone, bike, books..."
required
/>

<button type="submit">
Search
</button>

</form>
Discover items people are willing to swap in your local area.
</p>


</div>

</section>
<section class="section">

<div class="container">


<div class="section-heading">

<h2>
Recent Listings
</h2>


<p>
Discover items people are willing to exchange.
</p>


</div>



<div id="listings-grid" class="listing-grid">

<p>
Loading listings...
</p>


</div>


</div>

</section>





<section id="categories" class="section">


<div class="container">


<div id="category-sections">


<p>
Loading categories...
</p>


</div>


</div>


</section>





<section id="how-it-works" class="section">


<div class="container">


<div class="section-heading">


<h2>
How It Works
</h2>


<p>
Exchange items in three simple steps.
</p>


</div>




<div class="listing-grid">



<div class="listing-card">


<div class="listing-content">


<h3 class="listing-title">
1. Post Your Item
</h3>


<p class="listing-description">

Add photos and details about what you want to exchange.

</p>


</div>


</div>





<div class="listing-card">


<div class="listing-content">


<h3 class="listing-title">
2. Find Matches
</h3>


<p class="listing-description">

Browse items from people near you.

</p>


</div>


</div>





<div class="listing-card">


<div class="listing-content">


<h3 class="listing-title">
3. Exchange
</h3>


<p class="listing-description">

Contact the owner and complete your swap.

</p>


</div>


</div>




</div>


</div>


</section>




</main>





<footer>


<div class="container">


<strong>
GoodsForExchange
</strong>


<p>
Exchange what you have for what you want.
</p>


</div>


</footer>
<script>

import { createClient } from "@supabase/supabase-js";


const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);



function capitalizeText(text){

  if(!text) return "";

  return String(text)
  .toLowerCase()
  .replace(/\b\w/g, char => char.toUpperCase());

}




async function fetchRecentListings(){


const gridEl =
document.querySelector("#listings-grid");


if(!gridEl) return;



const {data:listings,error}=await supabase
  .from("listings")
  .select(`
    id,
    title,
    slug,
    description,
    country,
    city,
    landmark,
    distance,
    condition,
    desired_exchange,
    categories!inner(slug)
  `)

.order(
"created_at",
{
ascending:false
}
)

.limit(12);



if(error || !listings || listings.length===0){


gridEl.innerHTML =
"<p>No listings found.</p>";


return;


}



let cards="";



for(const item of listings){


const {data:images}=await supabase

.from("listing_images")

.select("image_url")

.eq(
"listing_id",
item.id
)

.limit(1);



const image =
images && images.length>0
?
images[0].image_url
:
null;



cards += `


<a 
href="/${item.city}/${item.categories.slug}/${item.slug}/"
class="listing-card"
>


<div class="listing-image-frame">


${
image

?

`
<img
class="listing-image"
src="${image}"
alt="${capitalizeText(item.title)}"
/>
`

:

`
<div style="font-size:50px">
📦
</div>
`

}


</div>



<div class="listing-content">


<h3 class="listing-title">

${capitalizeText(item.title)}

</h3>


<span class="condition">

${capitalizeText(item.condition || "Good")}

</span>



<p class="listing-description">

${capitalizeText(item.description || "")}

</p>



<div class="listing-meta">

📍 
${capitalizeText(item.city || "Karachi")}
${item.country ? ", " + capitalizeText(item.country) : ""}

<br>


${
item.landmark
?
`Near ${capitalizeText(item.landmark)}`
:
""
}


<br>


${
item.distance
?
`Approx ${capitalizeText(item.distance)}`
:
""
}


<br><br>


🔄 Looking for:

${capitalizeText(item.desired_exchange || "Any item")}


</div>


</div>


</a>


`;

}



gridEl.innerHTML = cards;



}







async function loadCategorySections(){



const container =
document.querySelector("#category-sections");



if(!container) return;




const categoryGroups = [

{
  title: "Electronics",
  description: "Phones, gadgets and computers available for exchange.",
  viewText: "View All Electronics",
  slugs: [
    "electronics",
    "mobile-phones",
    "computers"
  ]
},


{
  title: "Fashion & Clothing",
  description: "Clothes, shoes and accessories available for exchange.",
  viewText: "View All Clothing",
  slugs: [
    "clothing"
  ]
},


{
  title: "Home & Living",
  description: "Furniture and household items available for exchange.",
  viewText: "View All Home Items",
  slugs: [
    "furniture",
    "home-appliances"
  ]
},


{
  title: "Vehicles & Sports",
  description: "Bikes, vehicles and sports items available for exchange.",
  viewText: "View All Vehicles",
  slugs: [
    "vehicles",
    "sports"
  ]
},


{
  title: "Books & Others",
  description: "Books and useful items available for exchange.",
  viewText: "View All Books",
  slugs: [
    "books",
    "other"
  ]
}

];




let finalHTML="";




for(const group of categoryGroups){



const {data:categories}=await supabase

.from("categories")

.select("id")

.in(
"slug",
group.slugs
);




if(!categories || categories.length===0)
continue;



const ids =
categories.map(
item=>item.id
);




const {data:listings}=await supabase

.from("listings")

.select(`
id,
title,
description,
country,
city,
landmark,
distance,
condition,
slug,


categories(
  slug
),
desired_exchange
`)

.in(
"category_id",
ids
)

.order(
"created_at",
{
ascending:false
}
)

.limit(8);




if(!listings || listings.length===0)
continue;




finalHTML += `


<div class="section-heading">

<h2>

${group.title}

</h2>

</div>



<div class="listing-grid">


`;





for(const item of listings){



const {data:images}=await supabase

.from("listing_images")

.select("image_url")

.eq(
"listing_id",
item.id
)

.limit(1);



const image =
images && images.length>0
?
images[0].image_url
:
null;



finalHTML += `


<a
href="/${item.city}/${item.categories.slug}/${item.slug}/"
class="listing-card"
>


<div class="listing-image-frame">


${
image

?

`
<img
class="listing-image"
src="${image}"
alt="${capitalizeText(item.title)}"
/>
`

:

`
📦
`

}


</div>



<div class="listing-content">


<h3 class="listing-title">

${capitalizeText(item.title)}

</h3>


<span class="condition">

${capitalizeText(item.condition || "Good")}

</span>


<p class="listing-description">

${capitalizeText(item.description || "")}

</p>


<div class="listing-meta">

📍
${capitalizeText(item.city || "Karachi")}
${item.country ? ", " + capitalizeText(item.country) : ""}

<br>

${
item.landmark
?
`Near ${capitalizeText(item.landmark)}`
:
""
}

<br>

${
item.distance
?
`Approx ${capitalizeText(item.distance)}`
:
""
}

<br><br>

🔄 Looking for:

${capitalizeText(item.desired_exchange || "Any item")}

</div>



</div>


</a>


`;




}




finalHTML += `

</div>

`;



}



container.innerHTML =
finalHTML;



}




fetchRecentListings();

loadCategorySections();



</script>


</body>

</html>