<script>

import { createClient } from "@supabase/supabase-js";


const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

async function loadHomeCategories() {
  console.log("loadHomeCategories started");
  const categorySelect = document.querySelector("#home-category");

  if (!(categorySelect instanceof HTMLSelectElement)) {
    return;
  }

  const { data, error } = await supabase
    .from("categories")
    .select("id, name, slug, parent_id")
    .is("parent_id", null)
    .order("name");
    console.log("Categories returned:", data);
console.log("Category query error:", error);

  if (error) {
    console.error("Homepage category loading error:", error);
    return;
  }

  categorySelect.innerHTML = '<option value="">All Categories</option>';

  (data || []).forEach((category) => {
    const option = document.createElement("option");
    option.value = category.slug;
    option.textContent = category.name;
    categorySelect.appendChild(option);
  });
}




function capitalizeText(text){

  if(!text) return "";

  return String(text)
  .toLowerCase()
  .replace(/\b\w/g, char => char.toUpperCase());

}




async function fetchRecentListings(){


const gridEl =
document.querySelector("#listings-grid");


if(!gridEl) return;



const {data:listings,error}=await supabase
  .from("listings")
  .select(`
    id,
    title,
    slug,
    description,
    country,
    city,
    landmark,
    distance,
    condition,
    desired_exchange,
    categories!inner(slug)
  `)

.order(
"created_at",
{
ascending:false
}
)

.limit(12);



if(error || !listings || listings.length===0){


gridEl.innerHTML =
"<p>No listings found.</p>";


return;


}



let cards="";



for(const item of listings){


const {data:images}=await supabase

.from("listing_images")

.select("image_url")

.eq(
"listing_id",
item.id
)

.limit(1);



const image =
images && images.length>0
?
images[0].image_url
:
null;



cards += `


<a 
href="/${item.city}/${item.categories.slug}/${item.slug}/"
class="listing-card"
>


<div class="listing-image-frame">


${
image

?

`
<img
class="listing-image"
src="${image}"
alt="${capitalizeText(item.title)}"
/>
`

:

`
<div style="font-size:50px">
📦
</div>
`

}


</div>



<div class="listing-content">


<h3 class="listing-title">

${capitalizeText(item.title)}

</h3>


<span class="condition">

${capitalizeText(item.condition || "Good")}

</span>



<p class="listing-description">

${capitalizeText(item.description || "")}

</p>



<div class="listing-meta">

📍 
${capitalizeText(item.city || "Karachi")}
${item.country ? ", " + capitalizeText(item.country) : ""}

<br>


${
item.landmark
?
`Near ${capitalizeText(item.landmark)}`
:
""
}


<br>


${
item.distance
?
`Approx ${capitalizeText(item.distance)}`
:
""
}


<br><br>


🔄 Looking for:

${capitalizeText(item.desired_exchange || "Any item")}


</div>


</div>


</a>


`;

}



gridEl.innerHTML = cards;



}







async function loadCategorySections(){



const container =
document.querySelector("#category-sections");



if(!container) return;




const categoryGroups = [

{
  title: "Electronics",
  description: "Phones, gadgets and computers available for exchange.",
  viewText: "View All Electronics",
  slugs: [
    "electronics",
    "mobile-phones",
    "computers"
  ]
},


{
  title: "Fashion & Clothing",
  description: "Clothes, shoes and accessories available for exchange.",
  viewText: "View All Clothing",
  slugs: [
    "clothing"
  ]
},


{
  title: "Home & Living",
  description: "Furniture and household items available for exchange.",
  viewText: "View All Home Items",
  slugs: [
    "furniture",
    "home-appliances"
  ]
},


{
  title: "Vehicles & Sports",
  description: "Bikes, vehicles and sports items available for exchange.",
  viewText: "View All Vehicles",
  slugs: [
    "vehicles",
    "sports"
  ]
},


{
  title: "Books & Others",
  description: "Books and useful items available for exchange.",
  viewText: "View All Books",
  slugs: [
    "books",
    "other"
  ]
}

];




let finalHTML="";




for(const group of categoryGroups){



const {data:categories}=await supabase

.from("categories")

.select("id")

.in(
"slug",
group.slugs
);




if(!categories || categories.length===0)
continue;



const ids =
categories.map(
item=>item.id
);




const {data:listings}=await supabase

.from("listings")

.select(`
id,
title,
description,
country,
city,
landmark,
distance,
condition,
slug,


categories(
  slug
),
desired_exchange
`)

.in(
"category_id",
ids
)

.order(
"created_at",
{
ascending:false
}
)

.limit(8);




if(!listings || listings.length===0)
continue;




finalHTML += `


<div class="section-heading">

<h2>

${group.title}

</h2>

</div>



<div class="listing-grid">


`;





for(const item of listings){



const {data:images}=await supabase

.from("listing_images")

.select("image_url")

.eq(
"listing_id",
item.id
)

.limit(1);



const image =
images && images.length>0
?
images[0].image_url
:
null;



finalHTML += `


<a
href="/${item.city}/${item.categories.slug}/${item.slug}/"
class="listing-card"
>


<div class="listing-image-frame">


${
image

?

`
<img
class="listing-image"
src="${image}"
alt="${capitalizeText(item.title)}"
/>
`

:

`
📦
`

}


</div>



<div class="listing-content">


<h3 class="listing-title">

${capitalizeText(item.title)}

</h3>


<span class="condition">

${capitalizeText(item.condition || "Good")}

</span>


<p class="listing-description">

${capitalizeText(item.description || "")}

</p>


<div class="listing-meta">

📍
${capitalizeText(item.city || "Karachi")}
${item.country ? ", " + capitalizeText(item.country) : ""}

<br>

${
item.landmark
?
`Near ${capitalizeText(item.landmark)}`
:
""
}

<br>

${
item.distance
?
`Approx ${capitalizeText(item.distance)}`
:
""
}

<br><br>

🔄 Looking for:

${capitalizeText(item.desired_exchange || "Any item")}

</div>



</div>


</a>


`;




}




finalHTML += `

</div>

`;



}



container.innerHTML =
finalHTML;



}




loadHomeCategories();

fetchRecentListings();

