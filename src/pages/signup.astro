---
import Navbar from "../components/Navbar.astro";

const title = "Create Account | GoodsForExchange";
const description = "Create your GoodsForExchange account.";
---

<!doctype html>
<html lang="en">

<head>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>
<meta name="description" content={description} />

</head>


<body>

<Navbar />


<main class="auth-page">

<div class="auth-card">

<h1>Create Account</h1>

<p>
Join GoodsForExchange and start exchanging items.
</p>


<form id="signup-form">


<label>
Email
</label>

<input
id="email"
type="email"
placeholder="you@example.com"
required
/>


<label>
Password
</label>

<input
id="password"
type="password"
placeholder="Create password"
required
/>


<button type="submit">
Create Account
</button>


<p id="message"></p>


</form>


<p>

Already have an account?

<a href="/login/">
Login
</a>

</p>


</div>

</main>



<script>

import { createClient } from "@supabase/supabase-js";


const supabase = createClient(

import.meta.env.PUBLIC_SUPABASE_URL,

import.meta.env.PUBLIC_SUPABASE_ANON_KEY

);



const form =
document.querySelector("#signup-form");


const message =
document.querySelector("#message");



form?.addEventListener(
"submit",
async(e)=>{


e.preventDefault();



const email =
document.querySelector("#email").value;


const password =
document.querySelector("#password").value;



message.textContent =
"Creating account...";



const {error} =
await supabase.auth.signUp({

email,

password

});



if(error){

message.textContent =
error.message;

return;

}



message.textContent =
"Account created successfully. Redirecting...";



setTimeout(()=>{

window.location.href="/login/";

},1500);



});

</script>



<style>

*{
box-sizing:border-box;
}


body{

margin:0;
font-family:Inter,system-ui,sans-serif;
background:#f7fafb;
color:#172033;

}


.auth-page{

min-height:80vh;
display:flex;
align-items:center;
justify-content:center;
padding:40px;

}


.auth-card{

background:white;
width:min(430px,100%);
padding:35px;
border-radius:14px;
border:1px solid #e1e8ed;

}


h1{

margin-top:0;

}


label{

display:block;
margin-top:18px;
margin-bottom:6px;
font-weight:700;

}


input{

width:100%;
padding:12px;
border:1px solid #ccd7de;
border-radius:8px;

}


button{

width:100%;
margin-top:25px;
padding:13px;
border:0;
border-radius:8px;
background:#176b87;
color:white;
font-weight:700;
cursor:pointer;

}


a{

color:#176b87;

}


</style>


</body>

</html>